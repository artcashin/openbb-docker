# secrets & machine-specific config — never committed
credentials.env
api-auth.env
ts.env
deps.env
.env
.env.*
scripts/scrub-private-patterns.txt

# runtime state
ts-state/
kdb-data/
*.log

# kdb+ license -- bring your own; never commit it.
kdb-license/*
!kdb-license/.gitkeep

# The operator's own q binary -- bring your own; never commit it.
# Enforced by kdb/.gitignore itself (belt and suspenders: this directory
# must be structurally impossible to commit a binary into).

# python
__pycache__/
*.egg-info/
.pytest_cache/
.venv/
