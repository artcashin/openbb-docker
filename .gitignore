# Secrets — real API keys / connection strings (compose reads this at runtime)
credentials.env
*.env
!*.env.example
!.env.example


# Build/scratch
*.log
workspace/
.DS_Store

# Python build artifacts (mcp_stores/ and any future top-level Python code)
__pycache__/
*.pyc

# Nested extension repos — each is its own git repository, tracked separately.
openbb-alpaca/
openbb-arcticdb/
openbb-kdb/
openbb-eodhd/

# Derived connection env, generated from the dependency containers by the skill.
deps.env
