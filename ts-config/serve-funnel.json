{
  "TCP": {
    "443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://openbb-api:6900"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true
  },
  "Services": {
    "svc:openbb-api": {
      "TCP": {
        "443": {
          "HTTPS": true
        }
      },
      "Web": {
        "openbb-api.<your-tailnet>.ts.net:443": {
          "Handlers": {
            "/": {
              "Proxy": "http://openbb-api:6900"
            }
          }
        }
      }
    }
  }
}
