# OpenBB provider API keys — copy this file to `credentials.env` and fill in.
#   cp credentials.env.example credentials.env
# Then edit credentials.env. It is injected into the container via docker-compose
# (env_file). OpenBB reads these bare UPPERCASE names directly into its
# credentials; empty values are ignored, so you only need the providers you use.
#
# Keyless providers (yfinance, sec, federal_reserve, oecd, imf, ecb, finviz, ...)
# need nothing here.

# --- Common free-tier providers ---
FMP_API_KEY=                 # financialmodelingprep.com (free tier)
FRED_API_KEY=                # fred.stlouisfed.org/docs/api/api_key.html
TIINGO_TOKEN=                # tiingo.com (free token)
ALPHA_VANTAGE_API_KEY=       # alphavantage.co/support/#api-key
NASDAQ_API_KEY=              # data.nasdaq.com (Nasdaq Data Link)
EIA_API_KEY=                 # eia.gov/opendata/register.php
BLS_API_KEY=                 # data.bls.gov/registrationEngine
CFTC_APP_TOKEN=              # publicreporting.cftc.gov (Socrata app token)
CONGRESS_GOV_API_KEY=        # api.congress.gov/sign-up
ECONDB_API_KEY=              # econdb.com (optional; works keyless with limits)
BIZTOC_API_KEY=              # rapidapi.com biztoc

# --- Paid / premium providers ---
INTRINIO_API_KEY=            # intrinio.com
BENZINGA_API_KEY=            # benzinga.com/apis
TRADINGECONOMICS_API_KEY=    # tradingeconomics.com/api

# --- Brokerage (Tradier) ---
TRADIER_API_KEY=             # tradier.com brokerage access token
TRADIER_ACCOUNT_TYPE=        # "sandbox" or "live"

# --- Alpaca (custom provider: equity historical pricing) ---
ALPACA_API_KEY=              # alpaca.markets API key id
ALPACA_API_SECRET=           # alpaca.markets API secret key  (free acct -> IEX feed)

# --- EODHD (custom provider: equity/ETF historical, EOD + intraday) ---
EODHD_API_KEY=  # eodhd.com API token ('demo' works for AAPL.US/MCD.US/TSLA.US/VTI.US)

# --- ArcticDB (custom integration: store/serve data) — NOT credentials, just config.
# Default (no setup): a local LMDB store on the persistent openbb-data volume:
# ARCTICDB_URI=lmdb:///root/.openbb_platform/arcticdb
# ARCTICDB_LIBRARY=openbb
#
# Shared store via the bundled MinIO service (start: docker compose --profile s3 up -d).
# Uncomment these to make OpenBB read/write the shared S3 store instead of LMDB.
# NOTE the URI grammar: host has NO colon; the port is a separate `port=` param.
# `minio` is the compose service name; change it to the other machine's IP when
# you move MinIO off-box. Credentials below must match the MinIO root user/pass.
# ARCTICDB_URI=s3://minio:openbb?port=9000&access=minioadmin&secret=minioadmin&use_virtual_addressing=false
# ARCTICDB_LIBRARY=prices
#
# MinIO defaults are minioadmin/minioadmin and bucket 'openbb' (works as-is).
# To change them, set MINIO_ROOT_USER / MINIO_ROOT_PASSWORD / ARCTICDB_BUCKET in a
# `.env` file in this directory (compose reads `.env`, NOT this file, for the minio
# service) and make the access=/secret= in ARCTICDB_URI above match.
