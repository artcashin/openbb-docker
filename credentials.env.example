# OpenBB provider API keys — copy this file to `credentials.env` and fill in.
#   cp credentials.env.example credentials.env
# Then edit credentials.env. It is injected into the container via docker-compose
# (env_file). OpenBB reads these bare UPPERCASE names directly into its
# credentials; empty values are ignored, so you only need the providers you use.
#
# Keyless providers (yfinance, sec, federal_reserve, oecd, imf, ecb, finviz, ...)
# need nothing here.

# --- Common free-tier providers ---
# financialmodelingprep.com (free tier)
FMP_API_KEY=
# fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# tiingo.com (free token)
TIINGO_TOKEN=
# alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# data.nasdaq.com (Nasdaq Data Link)
NASDAQ_API_KEY=
# eia.gov/opendata/register.php
EIA_API_KEY=
# data.bls.gov/registrationEngine
BLS_API_KEY=
# publicreporting.cftc.gov (Socrata app token)
CFTC_APP_TOKEN=
# api.congress.gov/sign-up
CONGRESS_GOV_API_KEY=
# econdb.com (optional; works keyless with limits)
ECONDB_API_KEY=
# rapidapi.com biztoc
BIZTOC_API_KEY=

# --- Paid / premium providers ---
# intrinio.com
INTRINIO_API_KEY=
# benzinga.com/apis
BENZINGA_API_KEY=
# tradingeconomics.com/api
TRADINGECONOMICS_API_KEY=

# --- Brokerage (Tradier) ---
# tradier.com brokerage access token
TRADIER_API_KEY=
# "sandbox" or "live"
TRADIER_ACCOUNT_TYPE=

# --- Alpaca (custom provider: equity historical pricing) ---
# alpaca.markets API key id
ALPACA_API_KEY=
# alpaca.markets API secret key  (free acct -> IEX feed)
ALPACA_API_SECRET=

# --- EODHD (custom provider: equity/ETF historical, EOD + intraday) ---
# The public 'demo' key works — with NO limits, all data types incl. real-time —
# for these tickers only: AAPL.US, TSLA.US, VTI.US, AMZN.US, BTC-USD.CC, EURUSD.FOREX.
# Swap in your own eodhd.com token for anything else.
EODHD_API_KEY=demo

# --- Dependency containers (used by `update-openbb-docker --up` to START them if
#     stopped, and to DERIVE their connection env). Change these if you rename or
#     move the containers; set either to empty to disable that dependency.
KDB_CONTAINER=kdb-x
S3_CONTAINER=s3-local

# --- ArcticDB / kdb+ connection — NOT credentials, just config.
# You set only the non-secret knobs below. The endpoint host gateway, the
# published PORTS, and the MinIO access/secret are INHERITED from the dependency
# containers by `update-openbb-docker --up` / `--sync-deps` — `docker inspect`ed
# and written to deps.env (git-ignored), which compose loads AFTER this file so
# the derived values win. Nothing here is a secret.
#
# What each link in the chain contributes to the openbb container's env:
#
#   from KDB_CONTAINER (kdb-x):
#     KDB_PORT       <- the host port published for the container's :5000
#                       (e.g. 5001).                     -> deps.env
#     KDB_HOST       <- fixed gateway, set below (host.docker.internal); the
#                       container is reached via the host's published port.
#
#   from S3_CONTAINER (s3-local), all assembled into ARCTICDB_URI -> deps.env:
#     <port>         <- the host port published for the container's :9000
#     access=<user>  <- the container's MINIO_ROOT_USER env
#     secret=<pass>  <- the container's MINIO_ROOT_PASSWORD env
#     ARCTIC_ENDPOINT<- fixed gateway (host.docker.internal); override via the
#                       env var of the same name if MinIO is off-box.
#     <bucket>/<lib> <- ARCTICDB_BUCKET / ARCTICDB_LIBRARY set below (yours).
#
# The ARCTICDB_BUCKET must already exist — ArcticDB won't create it:
#   docker run --rm --network container:s3-local --entrypoint sh minio/mc:latest \
#     -c 'mc alias set l http://localhost:9000 <user> <pass>; mc mb -p l/openbb'
KDB_HOST=host.docker.internal
ARCTICDB_BUCKET=openbb
ARCTICDB_LIBRARY=openbb
#
# To use a local LMDB store instead of MinIO: set S3_CONTAINER= (empty) and
# uncomment: ARCTICDB_URI=lmdb:///root/.openbb_platform/arcticdb
