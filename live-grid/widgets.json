{
  "live_grid": {
    "name": "Live quotes",
    "description": "Real-time EODHD prices: US equities, crypto and forex in one watchlist. Type symbols into the widget.",
    "category": "Live",
    "type": "live_grid",
    "endpoint": "live_grid",
    "wsEndpoint": "live_grid_ws",
    "gridData": { "w": 40, "h": 12 },
    "data": {
      "wsRowIdColumn": "symbol",
      "table": {
        "showAll": false,
        "columnsDefs": [
          { "field": "symbol", "headerName": "Symbol", "pinned": "left" },
          { "field": "price", "headerName": "Price", "renderFn": "showCellChange", "renderFnParams": { "colorValueKey": "change" } },
          { "field": "change", "headerName": "Chg" },
          { "field": "change_percent", "headerName": "Chg %", "renderFn": "greenRed", "formatterFn": "percent" },
          { "field": "bid", "headerName": "Bid" },
          { "field": "ask", "headerName": "Ask" },
          { "field": "last_size", "headerName": "Last Size" },
          { "field": "volume", "headerName": "Volume", "enableCellChangeWs": false },
          { "field": "updated_at", "headerName": "Updated" }
        ]
      }
    },
    "params": [
      {
        "paramName": "symbol",
        "type": "text",
        "value": "AAPL,MSFT,TSLA,BTC-USD,ETH-USD,EURUSD",
        "label": "Symbols",
        "description": "Comma-separated watchlist: US equities (AAPL), crypto (BTC-USD), forex (EURUSD)",
        "multiSelect": true
      }
    ],
    "source": ["EODHD"]
  },
  "kdb_cache_chart": {
    "name": "Cached Price Chart",
    "description": "Historical prices served through the kdb+ read-through cache, joined to live tick-derived bars",
    "category": "Equity",
    "type": "chart",
    "endpoint": "chart",
    "gridData": { "w": 20, "h": 12 },
    "params": [
      { "paramName": "symbol", "value": "AAPL", "label": "Symbol", "type": "text" },
      {
        "paramName": "interval", "value": "1d", "label": "Interval", "type": "text",
        "options": [
          { "label": "1 day", "value": "1d" },
          { "label": "1 hour", "value": "1h" },
          { "label": "5 min", "value": "5m" }
        ]
      }
    ]
  }
}
